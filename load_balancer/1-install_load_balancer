#!/usr/bin/env bash
# Installs HAProxy and sends traffic to web-01 and web-02 with a roundrobin algorithm
apt-get -y update
apt-get -y install haproxy

# Let the init script (/etc/init.d/haproxy) manage HAProxy
if grep -q '^ENABLED=' /etc/default/haproxy
then
	sed -i 's/^ENABLED=.*/ENABLED=1/' /etc/default/haproxy
else
	echo "ENABLED=1" >> /etc/default/haproxy
fi

cat > /etc/haproxy/haproxy.cfg <<'CONF'
global
	log /dev/log local0
	log /dev/log local1 notice
	maxconn 2048
	user haproxy
	group haproxy
	daemon

defaults
	log global
	mode http
	option httplog
	option dontlognull
	timeout connect 5000
	timeout client 50000
	timeout server 50000

frontend http_front
	bind *:80
	default_backend web_servers

backend web_servers
	balance roundrobin
	server 7123-web-01 18.133.158.178:80 check
	server 7123-web-02 3.9.132.43:80 check
CONF

# HAProxy 1.9+ lowercases header names; keep "X-Served-By" spelled as Nginx sends it
if haproxy -v | grep -qE 'version (1\.9|[2-9])'
then
	sed -i 's/^\tdaemon$/\tdaemon\n\th1-case-adjust x-served-by X-Served-By/' /etc/haproxy/haproxy.cfg
	sed -i 's/^\toption dontlognull$/\toption dontlognull\n\toption h1-case-adjust-bogus-client/' /etc/haproxy/haproxy.cfg
fi

service haproxy restart
