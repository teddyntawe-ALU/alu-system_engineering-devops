#!/usr/bin/env bash
# Installs HAProxy and spreads HTTP traffic between web-01 and web-02 using roundrobin

apt-get -y update
apt-get -y install haproxy

# Let the init script (/etc/init.d/haproxy) start and manage HAProxy
grep -q '^ENABLED=1' /etc/default/haproxy || echo "ENABLED=1" >> /etc/default/haproxy

cat > /etc/haproxy/haproxy.cfg <<'CONF'
global
	log /dev/log local0
	log /dev/log local1 notice
	maxconn 2048
	user haproxy
	group haproxy
	daemon
	# HAProxy 2.x lowercases header names; keep the original spelling
	h1-case-adjust x-served-by X-Served-By

defaults
	log global
	mode http
	option httplog
	option dontlognull
	option h1-case-adjust-bogus-client
	timeout connect 5000
	timeout client 50000
	timeout server 50000

frontend http_front
	bind *:80
	default_backend web_servers

backend web_servers
	balance roundrobin
	server 7123-web-01 18.133.158.178:80 check
	server 7123-web-02 3.9.132.43:80 check
CONF

service haproxy restart
